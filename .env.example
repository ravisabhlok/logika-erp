# Copy this file to .env and fill in your local MySQL credentials

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=logika_erp

# App
SECRET_KEY=change-this-to-a-random-secret-string
COMPANY_NAME=Logika Systems India Pvt Ltd

# Set to 0.0.0.0 to allow other PCs on the office LAN to connect,
# or 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
PORT=8000
